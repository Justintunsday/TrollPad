#!/bin/sh
set -e
# Rootless branch: HOME cannot identify the jailbreak prefix.
jb_root_path=/var/jb
bundle_system=/System/Library/ControlCenter/Bundles/ContinuousExposeModule.bundle
bundle_jb=$jb_root_path/Library/ControlCenter/Bundles/ContinuousExposeModule.bundle
plistbuddy=$jb_root_path/usr/libexec/PlistBuddy
case "$1" in
  configure)
    if [ -d "$bundle_system" ] && [ -x "$plistbuddy" ]; then
      mkdir -p "$bundle_jb"
      for source in "$bundle_system"/*; do
        [ -e "$source" ] || continue
        name=${source##*/}
        [ "$name" = Info.plist ] && continue
        # -n prevents following an existing directory symlink on upgrade.
        ln -sfn "$source" "$bundle_jb/$name"
      done
      # Do not follow an old symlink into the read-only system bundle.
      rm -f "$bundle_jb/Info.plist"
      cp "$bundle_system/Info.plist" "$bundle_jb/Info.plist"
      "$plistbuddy" -c "Delete :SBIconVisibilityDefaultVisible" "$bundle_jb/Info.plist" >/dev/null 2>&1 || :
      "$plistbuddy" -c "Delete :SBIconVisibilitySetByAppPreference" "$bundle_jb/Info.plist" >/dev/null 2>&1 || :
      "$plistbuddy" -c "Add :UIDeviceFamily:0 integer 1" "$bundle_jb/Info.plist"
    fi
    ;;
esac
exit 0
